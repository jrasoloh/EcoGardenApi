			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Vérifie si la requête a réussi (code 200)",
							"if (pm.response.code === 200) {",
							"    // Récupère le contenu JSON",
							"    var jsonData = pm.response.json();",
							"    // Sauvegarde le token dans une variable d'environnement 'jwt_token'",
							"    pm.environment.set(\"jwt_token\", jsonData.token);",
							"    console.log(\"Token mis à jour !\");",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwt_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"login\": \"admin\",\n    \"password\": \"test\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
